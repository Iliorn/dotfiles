# Fish writes universal vars here; regenerated per machine.
fish/.config/fish/fish_variables

# Hyprland host-local overrides (monitor + workspace layout per machine).
hypr/.config/hypr/host.conf

# aerc local account file (built from .example, contains app-password setup)
aerc/.config/aerc/accounts.conf

# systemd --user enable writes its activation symlinks here, because stow
# links the whole of ~/.config/systemd/user into this repo. That is machine
# state, not configuration — and without this rule Ansible's dotfiles role
# stops on every run, on a dirty working tree nobody made dirty.
systemd/.config/systemd/user/*.target.wants/

# Machine state, not configuration. scripts/screens.sh rewrites screens.conf
# from the outputs that are actually connected, and scripts/lid.sh creates and
# removes lid-closed. stow links this directory into the repo, so a tracked
# copy makes the working tree dirty on every screen or lid change — which
# stops Ansible's dotfiles role, by design, on a change nobody made. Ansible
# seeds an empty screens.conf instead (roles/dotfiles).
hypr/.config/hypr/state/

# Backups of host-local files belong on the machine that made them, not on
# every machine that clones this repo.
*.bak
*.orig
*.old-*
*~
