/**
 * minimal — the one rofi theme, for `rofi -show drun` (super+space) and for
 * every dmenu run.
 *
 * Layout and type only. The colours are not here: theme-colors.rasi, imported
 * below, is generated by hypr/.config/hypr/scripts/theme.sh from the chosen
 * palette and defines bg, bg-alt, line, fg, muted and accent. config.rasi
 * loads this theme for every run, so
 * hypr/.config/hypr/scripts/{powermenu,power_profile,systemmenu,clipmenu}.sh
 * inherit the colours and pass only layout (width, lines, hidden input bar)
 * in -theme-str.
 *
 * If theme-colors.rasi is missing, the @import fails and rofi falls back to
 * its default theme with only a warning. `theme.sh ensure` (run before waybar
 * at login) creates it.
 *
 * IMPORTANT — do NOT set `children:` on `window`. rofi's default hierarchy
 * is window > mainbox > [inputbar, message, listview], and powermenu.sh
 * hides its search field with `mainbox { children: [listview]; }`. Moving
 * the children list up to `window` makes that override a no-op and the
 * powermenu grows a search bar it never wanted. Style mainbox instead —
 * that keeps every `-theme-str` caller working exactly as before.
 *
 * IMPORTANT — `highlight` will NOT take a variable reference on rofi 2.0
 * (the version on this fleet): `highlight: bold @accent;` makes rofi fail
 * to parse the WHOLE theme and silently fall back to its default, with
 * nothing but a warning on stderr. Verified on x220-1, 2026-08-23. So no
 * colour is set on it at all: `bold underline` takes the row's own text
 * colour, which is also the only thing that stays visible on the selected
 * row, where the background IS the accent.
 *
 * IMPORTANT — element-text must say `text-color: inherit`. The global
 * `text-color` in `*` hits element-text directly, so without it the text
 * ignores the selected element's `text-color: @bg` and shows light on the
 * light accent.
 */

@import "theme-colors"

* {
    background-color: transparent;
    text-color:       @fg;
    font:             "JetBrainsMono Nerd Font 12";
}

window {
    width:            560px;
    location:         center;
    anchor:           center;
    y-offset:         -8%;
    background-color: @bg;
    border:           1px;
    border-color:     @line;
    border-radius:    0px;
    padding:          0px;
}

mainbox {
    spacing: 0px;
    padding: 0px;
}

inputbar {
    background-color: @bg-alt;
    padding:  4px 14px;
    spacing:  10px;
    children: [ prompt, entry ];
}

prompt {
    str:            "❯";
    text-color:     @accent;
    vertical-align: 0.5;
}

entry {
    placeholder:       "";
    placeholder-color: @muted;
    cursor:            text;
    vertical-align:    0.5;
}

listview {
    lines:        12;
    columns:      1;
    fixed-height: false;
    scrollbar:    false;
    padding:      0px;
    spacing:      0px;
}

element {
    padding:       2px 14px;
    border-radius: 0px;
    spacing:       10px;
}

element normal.normal    { text-color: @fg; }
element alternate.normal { text-color: @fg; }

element selected.normal {
    background-color: @accent;
    text-color:       @bg;
}

element-text {
    vertical-align:   0.5;
    background-color: transparent;
    text-color:       inherit;
    /* no colour, see the header */
    highlight:        bold underline;
}

message { padding: 8px 14px; }
textbox { text-color: @muted; }
