/**
 * nord-minimal — the one rofi theme, for `rofi -show drun` (super+space) and
 * for every dmenu run.
 *
 * Nord palette, to match alacritty (background #2E3440) and the rest of the
 * desktop. config.rasi loads this theme for every run, so
 * hypr/.config/hypr/scripts/{powermenu,power_profile}.sh inherit the colours
 * and pass only layout (width, lines, hidden input bar) in -theme-str.
 *
 * IMPORTANT — do NOT set `children:` on `window`. rofi's default hierarchy
 * is window > mainbox > [inputbar, message, listview], and powermenu.sh
 * hides its search field with `mainbox { children: [listview]; }`. Moving
 * the children list up to `window` makes that override a no-op and the
 * powermenu grows a search bar it never wanted. Style mainbox instead —
 * that keeps every `-theme-str` caller working exactly as before.
 *
 * IMPORTANT — `highlight` will NOT take a variable reference on rofi 2.0
 * (the version on this fleet): `highlight: bold @accent;` makes rofi fail
 * to parse the WHOLE theme and silently fall back to its default, with
 * nothing but a warning on stderr. Literal colour only. Verified on
 * x220-1, 2026-08-23.
 */

* {
    bg:      #2E3440;
    bg-alt:  #3B4252;
    fg:      #D8DEE9;
    muted:   #6B7688;
    accent:  #88C0D0;

    background-color: transparent;
    text-color:       @fg;
    font:             "JetBrainsMono Nerd Font 12";
}

window {
    width:            560px;
    location:         center;
    anchor:           center;
    y-offset:         -8%;
    background-color: @bg;
    border:           1px;
    border-color:     #4C566A;
    border-radius:    8px;
    padding:          0px;
}

mainbox {
    spacing: 0px;
    padding: 0px;
}

inputbar {
    background-color: @bg-alt;
    padding:  4px 14px;
    spacing:  10px;
    children: [ prompt, entry ];
}

prompt {
    str:            "❯";
    text-color:     @accent;
    vertical-align: 0.5;
}

entry {
    placeholder:       "";
    placeholder-color: @muted;
    cursor:            text;
    vertical-align:    0.5;
}

listview {
    lines:        12;
    columns:      1;
    fixed-height: false;
    scrollbar:    false;
    padding:      0px;
    spacing:      0px;
}

element {
    padding:       2px 14px;
    border-radius: 0px;
    spacing:       10px;
}

element normal.normal    { text-color: @fg; }
element alternate.normal { text-color: @fg; }

element selected.normal {
    background-color: @accent;
    text-color:       @bg;
}

element-text {
    vertical-align: 0.5;
    /* literal, not @accent — see the header */
    highlight:      bold #88C0D0;
}

message { padding: 8px 14px; }
textbox { text-color: @muted; }
