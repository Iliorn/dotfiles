[Unit]
Description=Refresh Waybar taskr status when taskr data changes

[Path]
PathModified=%h/.taskr/tasks.db
PathModified=%h/.taskr/tasks.db-wal

# MakeDirectory=true was REMOVED on 2026-08-05. It creates the watched
# paths if they are missing -- and since these paths are FILES, systemd
# created them as empty DIRECTORIES. On a machine where this unit was
# enabled before taskr had ever run, tasks.db was therefore a directory,
# SQLite could not open it ("unable to open database file (14)"), and the
# waybar module silently vanished because its command failed. taskr
# creates ~/.taskr itself on first run, so nothing needs to pre-create it.
Unit=taskr-waybar-refresh.service

[Install]
WantedBy=default.target
