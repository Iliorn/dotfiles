[global]
    monitor = 0
    follow = mouse
    width = 300
    height = (0, 300)
    origin = top-right
    offset = (10, 10)
    scale = 0
    notification_limit = 5
    
    ### Udseende ###
    # TUI flavour: en notifikation er en tekstboks i en terminal — firkantet,
    # uigennemsigtig, tynd grå ramme som rofi og tooltips, ingen ikoner.
    transparency = 0
    separator_height = 1
    padding = 8
    horizontal_padding = 10
    text_icon_padding = 0
    frame_width = 1
    frame_color = "#4C566A"
    separator_color = frame
    font = JetBrainsMono Nerd Font 10
    corner_radius = 0
    icon_position = off
    highlight = "#88C0D0"
    progress_bar_frame_width = 1
    progress_bar_corner_radius = 0

[urgency_low]
    background = "#2e3440" # Mørk Nordic Grey
    foreground = "#d8dee9"
    timeout = 5

[urgency_normal]
    background = "#2e3440" # Samme som terminalen
    foreground = "#e5e9f0"
    timeout = 10

[urgency_critical]
    background = "#bf616a" # Nordic rød til advarsler
    foreground = "#eceff4"
    frame_color = "#d08770"
    timeout = 0
