{
  "logo": {
    "type": "small",
    "padding": {
      "top": 0,
      "left": 1,
      "right": 2
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;129;161;193",
      "values": "38;2;216;222;233"
    }
  },
  "modules": [
    {
      "type": "title",
      "color": "38;2;136;192;208"
    },
    {
      "type": "os",
      "key": "OS"
    },
    {
      "type": "kernel",
      "key": "Kernel"
    },
    {
      "type": "uptime",
      "key": "Up"
    },
    {
      "type": "packages",
      "key": "Pkgs"
    },
    {
      "type": "wm",
      "key": "WM"
    },
    {
      "type": "terminal",
      "key": "Term"
    },
    {
      "type": "shell",
      "key": "Shell"
    },
    {
      "type": "display",
      "key": "Disp"
    },
    {
      "type": "break"
    },
    {
      "type": "cpu",
      "key": "CPU",
      "format": "{name} ({cores-logical}t)"
    },
    {
      "type": "memory",
      "key": "RAM",
      "format": "{used} / {total} ({percentage})"
    },
    {
      "type": "disk",
      "key": "Disk",
      "format": "{size-used} / {size-total} ({size-percentage})"
    }
  ]
}