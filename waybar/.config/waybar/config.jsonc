{
  "layer": "top",
  "position": "top",
  "locale": "da_DK",
  "height": 34,
  "modules-left": [
    "custom/power",
    "hyprland/workspaces"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "tray",
    "custom/taskr-status",
    "pulseaudio",
    "bluetooth",
    "network",
    "custom/battery-t480",
    "custom/power_profile"
  ],

"hyprland/workspaces": {
    "show-special": true,
    "format": "{icon}",
    "on-click": "activate",
    "format-icons": {
      "special": "󰝚"
    }
  },
  
  "custom/taskr-status": {
    "format": "  {}",
    "return-type": "json",
    "exec": "$HOME/.config/waybar/scripts/taskr-status.sh",
    "interval": 300,
    "signal": 8,
    "tooltip": true,
    "on-click": "alacritty -e taskr",
    "on-click-right": "alacritty -e bash -c '$HOME/.config/waybar/scripts/taskr-add.sh'"
  },
  "custom/power_profile": {
    "format": "{}",
    "return-type": "json",
    "exec": "~/.config/hypr/scripts/waybar_power_status.sh",
    "on-click": "~/.config/hypr/scripts/power_profile.sh",
    "interval": 5,
    "tooltip": true
  },
  "custom/power": {
    "format": "",
    "tooltip": false,
    "on-click": "~/.config/hypr/scripts/powermenu.sh"
  },
  "clock": {
    "format": "{:L%H:%M | %A %d. %B}",
    "locale": "da_DK.UTF-8",
    "tooltip-format": "{calendar}",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 1,
      "weeks-pos": "right",
      "on-scroll": 1,
      // Minimalistisk: én accentfarve (i dag), resten en dæmpet gråskala
      // fra linjens egen palet. Hierarki via lysstyrke, ikke kulør — og
      // fed skrift kun ét sted, ellers betyder fremhævningen ingenting.
      "format": {
        "months": "<span color='#cdd6f4'>{}</span>",
        "days": "<span color='#cdd6f4'>{}</span>",
        "weeks": "<span color='#45475a'>{}</span>",
        "weekdays": "<span color='#6c7086'>{}</span>",
        "today": "<span color='#89b4fa'><b>{}</b></span>"
      }
    },
    // 'mode' er bevidst IKKE bundet: den skifter til årsvisning, som er
    // bredere end skærmen på en 1366x768-panel. Scroll flytter måned frem
    // og tilbage, hvilket dækker samme behov uden at sprænge vinduet.
    "actions": {
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },
  "bluetooth": {
    "format": "",
    // {num_connections} vises kun i format-connected — er intet tilsluttet,
    // falder modulet tilbage til "format" og står som et rent ikon uden 0.
    "format-connected": "󰂱 {num_connections}",
    "format-disabled": "󰂲",
    "on-click": "alacritty -e bluetui",
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}"
  },
  "custom/battery-t480": {
    "exec": "~/.config/waybar/battery-t480.sh",
    "interval": 10,
    "format": "{}",
    "markup": "none",
    "on-click": "alacritty -e sh -c 'upower -d; read'"
  },
  "network": {
    "format-wifi": "  {signalStrength}%",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰖪",
    "on-click": "alacritty -e sh -c 'impala'"
  },
  "tray": {
    "icon-size": 18,
    "spacing": 10
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 Mute",
    "format-icons": {
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "on-click": "pavucontrol",
    "scroll-step": 5
  }
}
