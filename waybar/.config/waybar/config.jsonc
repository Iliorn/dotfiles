{
  "layer": "top",
  "position": "top",
  "locale": "da_DK",
  "height": 34,
  "modules-left": [
    "custom/power",
    "hyprland/workspaces"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "tray",
    "custom/taskr-status",
    "pulseaudio",
    "bluetooth",
    "network",
    "custom/battery-t480",
    "custom/power_profile"
  ],

"hyprland/workspaces": {
    "show-special": true,
    "format": "{icon}",
    "on-click": "activate",
    "format-icons": {
      "special": "󰝚"
    }
  },
  
  "custom/taskr-status": {
    "format": "  {}",
    "return-type": "json",
    "exec": "$HOME/.config/waybar/scripts/taskr-status.sh",
    "interval": 300,
    "signal": 8,
    "tooltip": true,
    "on-click": "alacritty -e taskr",
    "on-click-right": "alacritty -e bash -c '$HOME/.config/waybar/scripts/taskr-add.sh'"
  },
  "custom/power_profile": {
    "format": "{}",
    "return-type": "json",
    "exec": "~/.config/hypr/scripts/waybar_power_status.sh",
    "on-click": "~/.config/hypr/scripts/power_profile.sh",
    "interval": 5,
    "tooltip": true
  },
  "custom/power": {
    "format": "",
    "tooltip": false,
    "on-click": "~/.config/hypr/scripts/powermenu.sh"
  },
  "clock": {
    "format": "{:L%H:%M | %A %d. %B}",
    "locale": "da_DK.UTF-8",
    // Uret er bevidst passivt: ingen tooltip ved hover, ingen handling ved
    // klik. Waybars indbyggede kalender var et GTK-tooltip, og GTK placerer
    // tooltips efter musemarkoeren — vinduet landede derfor et nyt sted alt
    // efter hvor paa uret man holdt musen, og det kan Waybar ikke styre.
    // gsimplecal blev proevet som erstatning (rigtigt vindue, som Hyprland
    // kan placere), men det placerede sig selv midt paa skaermen, saa hele
    // kalenderen er droppet. Dato og klokkeslaet staar i "format" ovenfor.
    "tooltip": false
  },
  "bluetooth": {
    // Tallet er skrevet fast som 0 her: "format" bruges netop naar intet er
    // tilsluttet, saa antallet kan ikke vaere andet. Modulet beholder samme
    // bredde i alle tilstande og hopper derfor ikke naar en enhed forbinder.
    "format": "<span size='large'></span> 0",
    "format-connected": "<span size='large'>󰂱</span> {num_connections}",
    "format-disabled": "󰂲",
    "on-click": "alacritty -e bluetui",
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}"
  },
  "custom/battery-t480": {
    "exec": "~/.config/waybar/battery-t480.sh",
    "interval": 10,
    "format": "{}",
    "markup": "none",
    "on-click": "alacritty -e sh -c 'upower -d; read'"
  },
  "network": {
    "format-wifi": "  {signalStrength}%",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰖪",
    "on-click": "alacritty -e sh -c 'impala'"
  },
  "tray": {
    "icon-size": 18,
    "spacing": 10
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 Mute",
    "format-icons": {
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "on-click": "pavucontrol",
    "scroll-step": 5
  }
}
