{
  "layer": "top",
  "position": "top",
  "locale": "da_DK",
  "height": 34,
  "modules-left": [
    "custom/power",
    "hyprland/workspaces"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "tray",
    "custom/fleet",
    "custom/hoth",
    "custom/tjek-status",
    "cpu",
    "memory",
    "pulseaudio",
    "bluetooth",
    "network",
    "custom/battery-t480",
    "custom/power_profile"
  ],

"hyprland/workspaces": {
    "show-special": true,
    // dropterm er rullegardin-terminalen (super+D, scripts/dropterm.sh). Den
    // er et vaerktoej, ikke et sted man bor, saa den skal ikke have en knap
    // ved siden af magic-skrivebordet. Moensteret passer baade med og uden
    // "special:" foran, saa det virker uanset hvordan Waybar navngiver den.
    "ignore-workspaces": ["(special:)?dropterm"],
    "format": "{icon}",
    "on-click": "activate",
    "format-icons": {
      "special": "󰝚"
    }
  },
  
  // hoth's health (scripts/hoth-status.sh): green, red with a count, or grey
  // when hoth cannot be reached. Click for the list.
  // What fleet-push on hoth has waiting for this laptop (scripts/fleet-status.sh):
  // hidden when nothing, a count when something needs a sudo run, "!" when
  // the last push failed. Click runs it, asking for the password.
  "custom/fleet": {
    "format": "{}",
    "return-type": "json",
    "exec": "$HOME/.config/waybar/scripts/fleet-status.sh",
    "interval": 120,
    "tooltip": true,
    "on-click": "alacritty -e $HOME/.config/waybar/scripts/fleet-status.sh run"
  },
  "custom/hoth": {
    "format": "󰒋 {}",
    "return-type": "json",
    "exec": "$HOME/.config/waybar/scripts/hoth-status.sh",
    "interval": 60,
    "tooltip": true,
    "on-click": "alacritty -e $HOME/.config/waybar/scripts/hoth-status.sh view"
  },
  "custom/tjek-status": {
    "format": "  {}",
    "return-type": "json",
    "exec": "$HOME/.config/waybar/scripts/tjek-status.sh",
    "interval": 300,
    "signal": 8,
    "tooltip": true,
    "on-click": "alacritty -e tjek",
    "on-click-right": "alacritty -e bash -c '$HOME/.config/waybar/scripts/tjek-add.sh'"
  },
  "custom/power_profile": {
    "format": "{}",
    "return-type": "json",
    "exec": "~/.config/hypr/scripts/waybar_power_status.sh",
    "on-click": "~/.config/hypr/scripts/systemmenu.sh",
    "interval": 5,
    "tooltip": true
  },
  "custom/power": {
    "format": "",
    "tooltip": false,
    "on-click": "~/.config/hypr/scripts/powermenu.sh"
  },
  "clock": {
    "format": "{:L%H:%M | %A %d. %B}",
    "locale": "da_DK.UTF-8",
    // Ingen tooltip ved hover. Waybars indbyggede kalender var et GTK-tooltip,
    // og GTK placerer tooltips efter musemarkoeren — vinduet landede derfor et
    // nyt sted alt efter hvor paa uret man holdt musen, og det kan Waybar ikke
    // styre. gsimplecal blev proevet som erstatning (rigtigt vindue, som
    // Hyprland kan placere), men det placerede sig selv midt paa skaermen.
    // Et klik aabner i stedet calcurse i en almindelig terminal, som
    // Hyprland placerer som alt andet. Dato og klokkeslaet staar i "format".
    "tooltip": false,
    "on-click": "alacritty -e calcurse"
  },
  "bluetooth": {
    // Tallet er skrevet fast som 0 her: "format" bruges netop naar intet er
    // tilsluttet, saa antallet kan ikke vaere andet. Modulet beholder samme
    // bredde i alle tilstande og hopper derfor ikke naar en enhed forbinder.
    "format": "<span size='large'></span> 0",
    "format-connected": "<span size='large'>󰂱</span> {num_connections}",
    "format-disabled": "󰂲",
    "on-click": "alacritty -e bluetui",
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}"
  },
  "custom/battery-t480": {
    // Ingen "interval": scriptet koerer vedvarende og skriver en linje pr.
    // UPower-event, saa ladeikonet skifter med det samme.
    "exec": "~/.config/waybar/battery-t480.sh",
    "restart-interval": 5,
    "format": "{}",
    "markup": "none",
    "on-click": "alacritty -e sh -c 'upower -d; read'"
  },
  "cpu": {
    "format": "󰻠 {usage}%",
    "interval": 5,
    "tooltip-format": "CPU {usage}%\nGennemsnit {avg_frequency} GHz",
    "on-click": "alacritty -e btop"
  },
  "memory": {
    "format": "󰍛 {percentage}%",
    "interval": 5,
    "tooltip-format": "{used:0.1f} GiB af {total:0.1f} GiB\nSwap {swapUsed:0.1f} GiB",
    "on-click": "alacritty -e btop"
  },
  "network": {
    "format-wifi": "  {signalStrength}%",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰖪",
    "on-click": "alacritty -e sh -c 'impala'"
  },
  "tray": {
    "icon-size": 18,
    "spacing": 10
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 Mute",
    "format-icons": {
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    // wiremix i en terminal; pavucontrol til en maskine uden wiremix endnu.
    "on-click": "if command -v wiremix >/dev/null; then alacritty -e wiremix; else pavucontrol; fi",
    "scroll-step": 5
  }
}
