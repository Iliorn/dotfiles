# Host-local Hyprland config (monitor layout + workspace pinning).
# Written once by Ansible (roles/dotfiles) and then left alone: edit freely.
# Extra monitors and workspace pinning go here, not in hyprland.conf.

################
### MONITORS ###
################
# Sandy Bridge: the built-in panel is LVDS-1, not eDP-1.
monitor = LVDS-1, preferred, auto, 1
# Anything else (currently a Dell S2721DGF on DP-2), placed to the right.
monitor = , highres, auto, 1

##################
### WORKSPACES ###
##################
# 1-3 belong to the laptop panel; 4+ follow the external screen.
# See hypr/scripts/lid.sh for why the pinning matters.
workspace = 1, monitor:LVDS-1, default:true
workspace = 2, monitor:LVDS-1
workspace = 3, monitor:LVDS-1
